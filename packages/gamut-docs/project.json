{
  "name": "gamut-docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/gamut-docs/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/gamut-docs",
        "command": "astro dev"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "packages/gamut-docs",
        "command": "astro build"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "packages/gamut-docs",
        "command": "astro preview"
      }
    },
    "full-site": {
      "executor": "@nx/storybook:build",
      "dependsOn": ["build"],
      "inputs": [
        { "input": "production", "projects": ["styleguide"] },
        "^production"
      ],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "outputDir": "packages/gamut-docs/dist/storybook",
        "configDir": "packages/styleguide/.storybook"
      }
    }
  }
}
