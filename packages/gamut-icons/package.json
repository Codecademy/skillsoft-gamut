{
  "name": "@skillsoft/gamut-icons",
  "description": "Icon library for codecademy.com",
  "version": "0.0.1",
  "author": "Skillsoft Engineering <dev@codecademy.com>",
  "dependencies": {
    "@skillsoft/gamut-styles": "^0.0.1",
    "@skillsoft/variance": "^0.0.1"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "peerDependencies": {
    "@emotion/react": "^11.4.0",
    "@emotion/styled": "^11.3.0",
    "react": "^17.0.2 || ^18.3.0 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": "git@github.com:Codecademy/skillsoft-gamut.git",
  "scripts": {
    "build": "nx build gamut-icons",
    "format": "svgo -f ./src/svg --pretty --config=.svgo.yml"
  },
  "sideEffects": false,
  "types": "dist/index.d.ts"
}
