{
  "name": "eslint-plugin-gamut",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/eslint-plugin-gamut/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/eslint-plugin-gamut",
        "commands": ["rm -rf ./dist", "tsc -p tsconfig.lib.json"],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/vitest"],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/vitest.config.ts",
        "{workspaceRoot}/script/vitest/node-setup.ts"
      ],
      "options": {
        "command": "vitest run --project=node --coverage.enabled=${CI:-false} packages/eslint-plugin-gamut"
      }
    },
    "publish-build": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": [],
        "parallel": false
      }
    }
  }
}
