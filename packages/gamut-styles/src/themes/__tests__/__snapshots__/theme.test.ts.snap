  "tokensCss": "/* Generated by scripts/build-tokens.ts from the "skillsoft", "originalCodecademy" brands ("skillsoft" is the default). Do not edit. */
@layer reset, base, tokens, recipes, utilities;

@layer tokens {
  :root, [data-brand="skillsoft"] {
    --color-white: oklch(1.0000 0.0000 0.00);
    --color-black: oklch(0.0000 0.0000 0.00);
    --color-palette-neutral-light-100: oklch(0.9862 0.0041 93.70);
    --color-palette-neutral-light-200: oklch(0.9364 0.0075 93.70);
    --color-palette-neutral-light-300: oklch(0.8497 0.0191 93.70);
    --color-palette-neutral-light-400: oklch(0.7628 0.0218 93.70);
    --color-palette-neutral-light-500: oklch(0.6707 0.0241 93.70);
    --color-palette-neutral-light-600: oklch(0.5835 0.0239 93.70);
    --color-palette-neutral-light-700: oklch(0.4972 0.0193 93.70);
    --color-palette-neutral-light-800: oklch(0.4115 0.0151 93.70);
    --color-palette-neutral-light-900: oklch(0.3346 0.0120 93.70);
    --color-palette-neutral-light-1000: oklch(0.2499 0.0086 93.70);
    --color-palette-neutral-light-1100: oklch(0.1925 0.0063 93.70);
    --color-palette-neutral-dark-100: oklch(0.9862 0.0012 270.70);
    --color-palette-neutral-dark-200: oklch(0.9364 0.0024 270.70);
    --color-palette-neutral-dark-300: oklch(0.8497 0.0081 270.70);
    --color-palette-neutral-dark-400: oklch(0.7628 0.0168 270.70);
    --color-palette-neutral-dark-500: oklch(0.6707 0.0305 270.70);
    --color-palette-neutral-dark-600: oklch(0.5835 0.0454 270.70);
    --color-palette-neutral-dark-700: oklch(0.4972 0.0538 270.70);
    --color-palette-neutral-dark-800: oklch(0.4115 0.0482 270.70);
    --color-palette-neutral-dark-900: oklch(0.3346 0.0383 270.70);
    --color-palette-neutral-dark-1000: oklch(0.2499 0.0273 270.70);
    --color-palette-neutral-dark-1100: oklch(0.1925 0.0200 270.70);
    --color-palette-neutral-dark-1100-a16: oklch(0.1925 0.0200 270.70 / 0.16);
    --color-palette-neutral-dark-1100-a12: oklch(0.1925 0.0200 270.70 / 0.12);
    --color-palette-primary-100: oklch(0.9862 0.0064 262.40);
    --color-palette-primary-200: oklch(0.9364 0.0121 262.40);
