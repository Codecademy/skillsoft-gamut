  :root, [data-color-mode="light"] {
    color-scheme: light;
    color: var(--colors-text-default);
    --colors-background-current: var(--colors-surface-default);
    --colors-surface-sunken: var(--colors-palette-neutral-light-200); /** Wells, insets, code blocks — anything recessed into the page. */
    --colors-surface-default: var(--colors-palette-neutral-light-100); /** The page background — the base every other surface elevates from. */
    --colors-surface-raised: var(--colors-white); /** Cards, panels, dialogs, menus. Higher elevation is lighter. */
    --colors-surface-success: var(--colors-palette-success-200); /** The success tint behind an alert or inline confirmation. */
    --colors-surface-warning: var(--colors-palette-warning-200); /** The warning tint behind an alert or inline caution. */
    --colors-surface-error: var(--colors-palette-danger-200); /** The error tint behind an alert or inline validation message. */
    --colors-surface-brand: var(--colors-palette-neutral-light-100); /** The two-color brand gradient. The color is the flat fallback; the gradient ships as --gradient-surface-brand. */
    --colors-surface-brand-subtle: var(--colors-palette-neutral-light-100); /** The one-color brand gradient, for backgrounds behind real text. Ships as --gradient-surface-brand-subtle. */
    --colors-text-default: var(--colors-palette-neutral-dark-1000); /** Body copy and headings. */
    --colors-text-subtle: var(--colors-palette-neutral-dark-800); /** Secondary text — descriptions, metadata, helper copy. */
    --colors-text-inverse: var(--colors-palette-neutral-light-200); /** Labels on a filled control — action-primary, -neutral, -danger. */
    --colors-text-success: var(--colors-palette-success-900); /** Success text and icons. */
    --colors-text-warning: var(--colors-palette-warning-900); /** Warning text and icons. Always with an icon. */
    --colors-text-error: var(--colors-palette-danger-900); /** Error text and icons. */
    --colors-border-strong: var(--colors-palette-neutral-dark-1100); /** Emphasis — an active field, a selected row. */
    --colors-border-default: var(--colors-palette-neutral-dark-600); /** Any border that carries meaning — control outlines, field borders. */
    --colors-border-subtle: var(--colors-palette-neutral-dark-300); /** Decorative hairlines — table rules, dividers. Contrast-exempt. */
    --colors-action-primary: var(--colors-palette-primary-800); /** Primary interactive fills, strokes, links and focus rings. */
    --colors-action-primary-hover: var(--colors-palette-primary-900); /** Hover for action-primary. */
    --colors-action-primary-pressed: var(--colors-palette-primary-1000); /** Pressed for action-primary. */
    --colors-action-danger: var(--colors-palette-danger-800); /** Destructive actions — delete, remove, revoke. */
    --colors-action-danger-hover: var(--colors-palette-danger-900); /** Hover for action-danger. */
    --colors-action-danger-pressed: var(--colors-palette-danger-1000); /** Pressed for action-danger. */
    --colors-action-neutral: var(--colors-palette-neutral-dark-1000); /** The neutral action fill. Button variant="secondary" resolves here. */
    --colors-action-neutral-hover: var(--colors-palette-neutral-dark-1100); /** Hover for action-neutral. */
    --colors-action-neutral-pressed: var(--colors-black); /** Pressed for action-neutral. */
    --colors-action-disabled: var(--colors-palette-neutral-light-400); /** The disabled fill for every action variant. Contrast-exempt (inactive control). */
    --colors-state-hover: var(--colors-palette-primary-600-a6); /** Rest → hover on rows, tabs, chips, menu items. */
    --colors-state-pressed: var(--colors-palette-primary-600-a9); /** Hover → pressed on the same elements. */
    --colors-state-selected: var(--colors-palette-primary-600-a8); /** The persistent "this one is chosen" tint. */
    --colors-viz-1: var(--colors-palette-primary-800); /** Categorical series 1. */
    --colors-viz-2: var(--colors-palette-accent-700); /** Categorical series 2. */
    --colors-viz-3: var(--colors-palette-warning-700); /** Categorical series 3. */
    --colors-viz-4: var(--colors-palette-accent-alt-600); /** Categorical series 4. */
    --colors-viz-5: var(--colors-palette-success-600); /** Categorical series 5. */
    --colors-viz-6: var(--colors-palette-danger-600); /** Categorical series 6. */
    --colors-viz-7: var(--colors-palette-neutral-dark-1000); /** Categorical series 7. */
    --colors-viz-8: var(--colors-palette-neutral-light-600); /** Categorical series 8. */
    --colors-viz-seq-1: var(--colors-palette-primary-600); /** Sequential step 1, low to high. */
    --colors-viz-seq-2: var(--colors-palette-primary-700); /** Sequential step 2, low to high. */
    --colors-viz-seq-3: var(--colors-palette-primary-800); /** Sequential step 3, low to high. */
    --colors-viz-seq-4: var(--colors-palette-primary-900); /** Sequential step 4, low to high. */
    --colors-backdrop: var(--colors-black-a60); /** The scrim behind modals and dialogs. Mode-independent. */
    --gradient-surface-brand: radial-gradient(circle calc(0.85 * 100cqw) at 100% -5%, color-mix(in oklab, var(--colors-palette-accent-300) 45%, transparent) 0%, color-mix(in oklab, var(--colors-palette-accent-300) 43%, transparent) 16%, color-mix(in oklab, var(--colors-palette-accent-300) 24%, transparent) 36%, color-mix(in oklab, var(--colors-palette-accent-300) 11%, transparent) 56%, color-mix(in oklab, var(--colors-palette-accent-300) 4%, transparent) 76%, color-mix(in oklab, var(--colors-palette-accent-300) 0%, transparent) 100%), radial-gradient(circle calc(1.21 * 100cqw) at 5% 100%, color-mix(in oklab, var(--colors-palette-primary-300) 45%, transparent) 0%, color-mix(in oklab, var(--colors-palette-primary-300) 43%, transparent) 16%, color-mix(in oklab, var(--colors-palette-primary-300) 24%, transparent) 36%, color-mix(in oklab, var(--colors-palette-primary-300) 11%, transparent) 56%, color-mix(in oklab, var(--colors-palette-primary-300) 4%, transparent) 76%, color-mix(in oklab, var(--colors-palette-primary-300) 0%, transparent) 100%);
    --gradient-surface-brand-subtle: radial-gradient(circle calc(0.78 * 100cqw) at 50% -10%, color-mix(in oklab, var(--colors-palette-primary-300) 45%, transparent) 0%, color-mix(in oklab, var(--colors-palette-primary-300) 43%, transparent) 16%, color-mix(in oklab, var(--colors-palette-primary-300) 24%, transparent) 36%, color-mix(in oklab, var(--colors-palette-primary-300) 11%, transparent) 56%, color-mix(in oklab, var(--colors-palette-primary-300) 4%, transparent) 76%, color-mix(in oklab, var(--colors-palette-primary-300) 0%, transparent) 100%);
  }

  [data-color-mode="dark"] {
    color-scheme: dark;
    color: var(--colors-text-default);
    --colors-background-current: var(--colors-surface-default);
    --colors-surface-sunken: var(--colors-black); /** Wells, insets, code blocks — anything recessed into the page. */
    --colors-surface-default: var(--colors-palette-neutral-dark-1100); /** The page background — the base every other surface elevates from. */
    --colors-surface-raised: var(--colors-palette-neutral-dark-1000); /** Cards, panels, dialogs, menus. Higher elevation is lighter. */
    --colors-surface-success: var(--colors-palette-success-1000); /** The success tint behind an alert or inline confirmation. */
    --colors-surface-warning: var(--colors-palette-warning-1000); /** The warning tint behind an alert or inline caution. */
    --colors-surface-error: var(--colors-palette-danger-1000); /** The error tint behind an alert or inline validation message. */
    --colors-surface-brand: var(--colors-palette-neutral-dark-1100); /** The two-color brand gradient. The color is the flat fallback; the gradient ships as --gradient-surface-brand. */
    --colors-surface-brand-subtle: var(--colors-palette-neutral-dark-1100); /** The one-color brand gradient, for backgrounds behind real text. Ships as --gradient-surface-brand-subtle. */
    --colors-text-default: var(--colors-palette-neutral-light-200); /** Body copy and headings. */
    --colors-text-subtle: var(--colors-palette-neutral-light-400); /** Secondary text — descriptions, metadata, helper copy. */
    --colors-text-inverse: var(--colors-palette-neutral-dark-1000); /** Labels on a filled control — action-primary, -neutral, -danger. */
    --colors-text-success: var(--colors-palette-success-300); /** Success text and icons. */
    --colors-text-warning: var(--colors-palette-warning-300); /** Warning text and icons. Always with an icon. */
    --colors-text-error: var(--colors-palette-danger-300); /** Error text and icons. */
    --colors-border-strong: var(--colors-palette-neutral-light-100); /** Emphasis — an active field, a selected row. */
    --colors-border-default: var(--colors-palette-neutral-light-600); /** Any border that carries meaning — control outlines, field borders. */
    --colors-border-subtle: var(--colors-palette-neutral-light-900); /** Decorative hairlines — table rules, dividers. Contrast-exempt. */
    --colors-action-primary: var(--colors-palette-primary-400); /** Primary interactive fills, strokes, links and focus rings. */
    --colors-action-primary-hover: var(--colors-palette-primary-300); /** Hover for action-primary. */
    --colors-action-primary-pressed: var(--colors-palette-primary-200); /** Pressed for action-primary. */
    --colors-action-danger: var(--colors-palette-danger-400); /** Destructive actions — delete, remove, revoke. */
    --colors-action-danger-hover: var(--colors-palette-danger-300); /** Hover for action-danger. */
    --colors-action-danger-pressed: var(--colors-palette-danger-200); /** Pressed for action-danger. */
    --colors-action-neutral: var(--colors-palette-neutral-light-200); /** The neutral action fill. Button variant="secondary" resolves here. */
    --colors-action-neutral-hover: var(--colors-palette-neutral-light-100); /** Hover for action-neutral. */
    --colors-action-neutral-pressed: var(--colors-white); /** Pressed for action-neutral. */
    --colors-action-disabled: var(--colors-palette-neutral-dark-800); /** The disabled fill for every action variant. Contrast-exempt (inactive control). */
    --colors-state-hover: var(--colors-palette-primary-600-a6); /** Rest → hover on rows, tabs, chips, menu items. */
    --colors-state-pressed: var(--colors-palette-primary-600-a9); /** Hover → pressed on the same elements. */
    --colors-state-selected: var(--colors-palette-primary-600-a8); /** The persistent "this one is chosen" tint. */
    --colors-viz-1: var(--colors-palette-primary-500); /** Categorical series 1. */
    --colors-viz-2: var(--colors-palette-accent-500); /** Categorical series 2. */
    --colors-viz-3: var(--colors-palette-warning-400); /** Categorical series 3. */
    --colors-viz-4: var(--colors-palette-accent-alt-600); /** Categorical series 4. */
