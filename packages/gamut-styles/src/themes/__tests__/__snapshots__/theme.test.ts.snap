    --colors-surface-brand: var(--colors-palette-neutral-dark-1100); /** The two-color brand gradient. The color is the flat fallback; the gradient ships as --gradient-surface-brand. */
    --colors-surface-brand-subtle: var(--colors-palette-neutral-dark-1100); /** The one-color brand gradient, for backgrounds behind real text. Ships as --gradient-surface-brand-subtle. */
    --colors-text-default: var(--colors-palette-neutral-light-200); /** Body copy and headings. */
    --colors-text-subtle: var(--colors-palette-neutral-light-400); /** Secondary text — descriptions, metadata, helper copy. */
    --colors-text-inverse: var(--colors-palette-neutral-dark-1000); /** Labels on a filled control — action-primary, -neutral, -danger. */
    --colors-text-success: var(--colors-palette-success-300); /** Success text and icons. */
    --colors-text-warning: var(--colors-palette-warning-300); /** Warning text and icons. Always with an icon. */
    --colors-text-error: var(--colors-palette-danger-300); /** Error text and icons. */
    --colors-border-strong: var(--colors-palette-neutral-light-100); /** Emphasis — an active field, a selected row. */
    --colors-border-default: var(--colors-palette-neutral-light-600); /** Any border that carries meaning — control outlines, field borders. */
    --colors-border-subtle: var(--colors-palette-neutral-light-900); /** Decorative hairlines — table rules, dividers. Contrast-exempt. */
    --colors-action-primary: var(--colors-palette-primary-400); /** Primary interactive fills, strokes, links and focus rings. */
    --colors-action-primary-hover: var(--colors-palette-primary-300); /** Hover for action-primary. */
    --colors-action-primary-pressed: var(--colors-palette-primary-200); /** Pressed for action-primary. */
    --colors-action-danger: var(--colors-palette-danger-400); /** Destructive actions — delete, remove, revoke. */
    --colors-action-danger-hover: var(--colors-palette-danger-300); /** Hover for action-danger. */
    --colors-action-danger-pressed: var(--colors-palette-danger-200); /** Pressed for action-danger. */
    --colors-action-neutral: var(--colors-palette-neutral-light-200); /** The neutral action fill. Button variant="secondary" resolves here. */
    --colors-action-neutral-hover: var(--colors-palette-neutral-light-100); /** Hover for action-neutral. */
    --colors-action-neutral-pressed: var(--colors-white); /** Pressed for action-neutral. */
    --colors-action-disabled: var(--colors-palette-neutral-dark-800); /** The disabled fill for every action variant. Contrast-exempt (inactive control). */
    --colors-state-hover: var(--colors-palette-primary-600-a6); /** Rest → hover on rows, tabs, chips, menu items. */
    --colors-state-pressed: var(--colors-palette-primary-600-a9); /** Hover → pressed on the same elements. */
    --colors-state-selected: var(--colors-palette-primary-600-a8); /** The persistent "this one is chosen" tint. */
    --colors-viz-1: var(--colors-palette-primary-500); /** Categorical series 1. */
    --colors-viz-2: var(--colors-palette-accent-500); /** Categorical series 2. */
    --colors-viz-3: var(--colors-palette-warning-400); /** Categorical series 3. */
