  :root, [data-color-mode="light"] {
    color-scheme: light;
    color: var(--color-text-default);
    --color-background-current: var(--color-surface-default);
    --color-surface-sunken: var(--color-palette-neutral-light-200); /** Wells, insets, code blocks — anything recessed into the page. */
    --color-surface-default: var(--color-palette-neutral-light-100); /** The page background — the base every other surface elevates from. */
    --color-surface-raised: var(--color-white); /** The lighter surface step, not a depth: cards, menus, dialogs, fields, and flat bordered sections. Shadow, not the fill, says how high something sits. */
    --color-surface-success: var(--color-palette-success-200); /** The success tint behind an alert or inline confirmation. */
    --color-surface-warning: var(--color-palette-warning-200); /** The warning tint behind an alert or inline caution. */
    --color-surface-error: var(--color-palette-danger-200); /** The error tint behind an alert or inline validation message. */
    --color-surface-brand: var(--color-palette-neutral-light-100); /** The two-color brand gradient. The color is the flat fallback; the gradient ships as --gradient-surface-brand. */
    --color-surface-brand-subtle: var(--color-palette-neutral-light-100); /** The one-color brand gradient, for backgrounds behind real text. Ships as --gradient-surface-brand-subtle. */
    --color-text-default: var(--color-palette-neutral-dark-1000); /** Body copy and headings. */
    --color-text-subtle: var(--color-palette-neutral-dark-800); /** Secondary text — descriptions, metadata, helper copy. */
    --color-text-inverse: var(--color-palette-neutral-light-200); /** Labels on a filled control — action-primary, -neutral, -danger. */
    --color-text-success: var(--color-palette-success-900); /** Success text and icons. */
    --color-text-warning: var(--color-palette-warning-900); /** Warning text and icons. Always with an icon. */
    --color-text-error: var(--color-palette-danger-900); /** Error text and icons. */
    --color-border-strong: var(--color-palette-neutral-dark-1100); /** Emphasis — an active field, a selected row. */
    --color-border-default: var(--color-palette-neutral-dark-600); /** Any border that carries meaning — control outlines, field borders. */
    --color-border-subtle: var(--color-palette-neutral-dark-300); /** Decorative hairlines — table rules, dividers. Contrast-exempt. */
    --color-action-primary: var(--color-palette-primary-800); /** Primary interactive fills, strokes, links and focus rings. */
    --color-action-primary-hover: var(--color-palette-primary-900); /** Hover for action-primary. */
    --color-action-primary-pressed: var(--color-palette-primary-1000); /** Pressed for action-primary. */
    --color-action-danger: var(--color-palette-danger-800); /** Destructive actions — delete, remove, revoke. */
    --color-action-danger-hover: var(--color-palette-danger-900); /** Hover for action-danger. */
    --color-action-danger-pressed: var(--color-palette-danger-1000); /** Pressed for action-danger. */
    --color-action-neutral: var(--color-palette-neutral-dark-1000); /** The neutral action fill. Button variant="secondary" resolves here. */
    --color-action-neutral-hover: var(--color-palette-neutral-dark-1100); /** Hover for action-neutral. */
    --color-action-neutral-pressed: var(--color-black); /** Pressed for action-neutral. */
    --color-action-disabled: var(--color-palette-neutral-light-400); /** The disabled fill for every action variant. Contrast-exempt (inactive control). */
    --color-state-hover: var(--color-palette-primary-600-a6); /** Rest → hover on rows, tabs, chips, menu items. */
    --color-state-pressed: var(--color-palette-primary-600-a9); /** Hover → pressed on the same elements. */
    --color-state-selected: var(--color-palette-primary-600-a8); /** The persistent "this one is chosen" tint. */
    --color-viz-1: var(--color-palette-primary-800); /** Categorical series 1. */
    --color-viz-2: var(--color-palette-accent-700); /** Categorical series 2. */
    --color-viz-3: var(--color-palette-warning-700); /** Categorical series 3. */
    --color-viz-4: var(--color-palette-accent-alt-600); /** Categorical series 4. */
    --color-viz-5: var(--color-palette-success-600); /** Categorical series 5. */
    --color-viz-6: var(--color-palette-danger-600); /** Categorical series 6. */
    --color-viz-7: var(--color-palette-neutral-dark-1000); /** Categorical series 7. */
    --color-viz-8: var(--color-palette-neutral-light-600); /** Categorical series 8. */
    --color-viz-seq-1: var(--color-palette-primary-600); /** Sequential step 1, low to high. */
    --color-viz-seq-2: var(--color-palette-primary-700); /** Sequential step 2, low to high. */
    --color-viz-seq-3: var(--color-palette-primary-800); /** Sequential step 3, low to high. */
    --color-viz-seq-4: var(--color-palette-primary-900); /** Sequential step 4, low to high. */
    --color-shadow-key: var(--color-palette-neutral-dark-1100-a16); /** The tight, darker layer of an elevation shadow. Box-shadow color only; the elevation supplies offset and blur. */
    --color-shadow-ambient: var(--color-palette-neutral-dark-1100-a12); /** The wide, soft layer of an elevation shadow, always paired with shadow-key. Transparent where a brand has no soft falloff. */
    --color-shadow-scrim: var(--color-black-a60); /** The scrim behind modals and dialogs. Mode-independent. */
    --gradient-surface-brand: radial-gradient(circle calc(0.85 * 100cqw) at 100% -5%, color-mix(in oklab, var(--color-palette-accent-300) 45%, transparent) 0%, color-mix(in oklab, var(--color-palette-accent-300) 43%, transparent) 16%, color-mix(in oklab, var(--color-palette-accent-300) 24%, transparent) 36%, color-mix(in oklab, var(--color-palette-accent-300) 11%, transparent) 56%, color-mix(in oklab, var(--color-palette-accent-300) 4%, transparent) 76%, color-mix(in oklab, var(--color-palette-accent-300) 0%, transparent) 100%), radial-gradient(circle calc(1.21 * 100cqw) at 5% 100%, color-mix(in oklab, var(--color-palette-primary-300) 45%, transparent) 0%, color-mix(in oklab, var(--color-palette-primary-300) 43%, transparent) 16%, color-mix(in oklab, var(--color-palette-primary-300) 24%, transparent) 36%, color-mix(in oklab, var(--color-palette-primary-300) 11%, transparent) 56%, color-mix(in oklab, var(--color-palette-primary-300) 4%, transparent) 76%, color-mix(in oklab, var(--color-palette-primary-300) 0%, transparent) 100%);
    --gradient-surface-brand-subtle: radial-gradient(circle calc(0.78 * 100cqw) at 50% -10%, color-mix(in oklab, var(--color-palette-primary-300) 45%, transparent) 0%, color-mix(in oklab, var(--color-palette-primary-300) 43%, transparent) 16%, color-mix(in oklab, var(--color-palette-primary-300) 24%, transparent) 36%, color-mix(in oklab, var(--color-palette-primary-300) 11%, transparent) 56%, color-mix(in oklab, var(--color-palette-primary-300) 4%, transparent) 76%, color-mix(in oklab, var(--color-palette-primary-300) 0%, transparent) 100%);
  }

  [data-color-mode="dark"] {
    color-scheme: dark;
    color: var(--color-text-default);
    --color-background-current: var(--color-surface-default);
    --color-surface-sunken: var(--color-black); /** Wells, insets, code blocks — anything recessed into the page. */
    --color-surface-default: var(--color-palette-neutral-dark-1100); /** The page background — the base every other surface elevates from. */
    --color-surface-raised: var(--color-palette-neutral-dark-1000); /** The lighter surface step, not a depth: cards, menus, dialogs, fields, and flat bordered sections. Shadow, not the fill, says how high something sits. */
    --color-surface-success: var(--color-palette-success-1000); /** The success tint behind an alert or inline confirmation. */
    --color-surface-warning: var(--color-palette-warning-1000); /** The warning tint behind an alert or inline caution. */
    --color-surface-error: var(--color-palette-danger-1000); /** The error tint behind an alert or inline validation message. */
    --color-surface-brand: var(--color-palette-neutral-dark-1100); /** The two-color brand gradient. The color is the flat fallback; the gradient ships as --gradient-surface-brand. */
    --color-surface-brand-subtle: var(--color-palette-neutral-dark-1100); /** The one-color brand gradient, for backgrounds behind real text. Ships as --gradient-surface-brand-subtle. */
    --color-text-default: var(--color-palette-neutral-light-200); /** Body copy and headings. */
    --color-text-subtle: var(--color-palette-neutral-light-400); /** Secondary text — descriptions, metadata, helper copy. */
    --color-text-inverse: var(--color-palette-neutral-dark-1000); /** Labels on a filled control — action-primary, -neutral, -danger. */
    --color-text-success: var(--color-palette-success-300); /** Success text and icons. */
    --color-text-warning: var(--color-palette-warning-300); /** Warning text and icons. Always with an icon. */
    --color-text-error: var(--color-palette-danger-300); /** Error text and icons. */
    --color-border-strong: var(--color-palette-neutral-light-100); /** Emphasis — an active field, a selected row. */
    --color-border-default: var(--color-palette-neutral-light-600); /** Any border that carries meaning — control outlines, field borders. */
    --color-border-subtle: var(--color-palette-neutral-light-900); /** Decorative hairlines — table rules, dividers. Contrast-exempt. */
    --color-action-primary: var(--color-palette-primary-400); /** Primary interactive fills, strokes, links and focus rings. */
    --color-action-primary-hover: var(--color-palette-primary-300); /** Hover for action-primary. */
    --color-action-primary-pressed: var(--color-palette-primary-200); /** Pressed for action-primary. */
    --color-action-danger: var(--color-palette-danger-400); /** Destructive actions — delete, remove, revoke. */
    --color-action-danger-hover: var(--color-palette-danger-300); /** Hover for action-danger. */
    --color-action-danger-pressed: var(--color-palette-danger-200); /** Pressed for action-danger. */
    --color-action-neutral: var(--color-palette-neutral-light-200); /** The neutral action fill. Button variant="secondary" resolves here. */
    --color-action-neutral-hover: var(--color-palette-neutral-light-100); /** Hover for action-neutral. */
    --color-action-neutral-pressed: var(--color-white); /** Pressed for action-neutral. */
    --color-action-disabled: var(--color-palette-neutral-dark-800); /** The disabled fill for every action variant. Contrast-exempt (inactive control). */
    --color-state-hover: var(--color-palette-primary-600-a6); /** Rest → hover on rows, tabs, chips, menu items. */
    --color-state-pressed: var(--color-palette-primary-600-a9); /** Hover → pressed on the same elements. */
    --color-state-selected: var(--color-palette-primary-600-a8); /** The persistent "this one is chosen" tint. */
    --color-viz-1: var(--color-palette-primary-500); /** Categorical series 1. */
    --color-viz-2: var(--color-palette-accent-500); /** Categorical series 2. */
    --color-viz-3: var(--color-palette-warning-400); /** Categorical series 3. */
    --color-viz-4: var(--color-palette-accent-alt-600); /** Categorical series 4. */
    --color-viz-5: var(--color-palette-success-300); /** Categorical series 5. */
    --color-viz-6: var(--color-palette-danger-600); /** Categorical series 6. */
    --color-viz-7: var(--color-palette-neutral-dark-500); /** Categorical series 7. */
    --color-viz-8: var(--color-palette-neutral-light-600); /** Categorical series 8. */
    --color-viz-seq-1: var(--color-palette-primary-600); /** Sequential step 1, low to high. */
    --color-viz-seq-2: var(--color-palette-primary-500); /** Sequential step 2, low to high. */
    --color-viz-seq-3: var(--color-palette-primary-400); /** Sequential step 3, low to high. */
    --color-viz-seq-4: var(--color-palette-primary-300); /** Sequential step 4, low to high. */
    --color-shadow-key: var(--color-black-a32); /** The tight, darker layer of an elevation shadow. Box-shadow color only; the elevation supplies offset and blur. */
    --color-shadow-ambient: var(--color-black-a24); /** The wide, soft layer of an elevation shadow, always paired with shadow-key. Transparent where a brand has no soft falloff. */
    --color-shadow-scrim: var(--color-black-a60); /** The scrim behind modals and dialogs. Mode-independent. */
    --gradient-surface-brand: radial-gradient(circle calc(0.85 * 100cqw) at 100% -5%, color-mix(in oklab, var(--color-palette-accent-900) 45%, transparent) 0%, color-mix(in oklab, var(--color-palette-accent-900) 43%, transparent) 16%, color-mix(in oklab, var(--color-palette-accent-900) 24%, transparent) 36%, color-mix(in oklab, var(--color-palette-accent-900) 11%, transparent) 56%, color-mix(in oklab, var(--color-palette-accent-900) 4%, transparent) 76%, color-mix(in oklab, var(--color-palette-accent-900) 0%, transparent) 100%), radial-gradient(circle calc(1.21 * 100cqw) at 5% 100%, color-mix(in oklab, var(--color-palette-primary-900) 45%, transparent) 0%, color-mix(in oklab, var(--color-palette-primary-900) 43%, transparent) 16%, color-mix(in oklab, var(--color-palette-primary-900) 24%, transparent) 36%, color-mix(in oklab, var(--color-palette-primary-900) 11%, transparent) 56%, color-mix(in oklab, var(--color-palette-primary-900) 4%, transparent) 76%, color-mix(in oklab, var(--color-palette-primary-900) 0%, transparent) 100%);
    --gradient-surface-brand-subtle: radial-gradient(circle calc(0.78 * 100cqw) at 50% -10%, color-mix(in oklab, var(--color-palette-primary-900) 45%, transparent) 0%, color-mix(in oklab, var(--color-palette-primary-900) 43%, transparent) 16%, color-mix(in oklab, var(--color-palette-primary-900) 24%, transparent) 36%, color-mix(in oklab, var(--color-palette-primary-900) 11%, transparent) 56%, color-mix(in oklab, var(--color-palette-primary-900) 4%, transparent) 76%, color-mix(in oklab, var(--color-palette-primary-900) 0%, transparent) 100%);
  }

  [data-brand="originalCodecademy"][data-color-mode="light"] {
    --color-shadow-ambient: var(--color-palette-neutral-dark-1100-a0);
    --gradient-surface-brand: radial-gradient(circle calc(0.85 * 100cqw) at 100% -5%, color-mix(in oklab, var(--color-palette-accent-alt-300) 45%, transparent) 0%, color-mix(in oklab, var(--color-palette-accent-alt-300) 43%, transparent) 16%, color-mix(in oklab, var(--color-palette-accent-alt-300) 24%, transparent) 36%, color-mix(in oklab, var(--color-palette-accent-alt-300) 11%, transparent) 56%, color-mix(in oklab, var(--color-palette-accent-alt-300) 4%, transparent) 76%, color-mix(in oklab, var(--color-palette-accent-alt-300) 0%, transparent) 100%), radial-gradient(circle calc(1.21 * 100cqw) at 5% 100%, color-mix(in oklab, var(--color-palette-primary-300) 45%, transparent) 0%, color-mix(in oklab, var(--color-palette-primary-300) 43%, transparent) 16%, color-mix(in oklab, var(--color-palette-primary-300) 24%, transparent) 36%, color-mix(in oklab, var(--color-palette-primary-300) 11%, transparent) 56%, color-mix(in oklab, var(--color-palette-primary-300) 4%, transparent) 76%, color-mix(in oklab, var(--color-palette-primary-300) 0%, transparent) 100%);
  }

  [data-brand="originalCodecademy"][data-color-mode="dark"] {
    --color-action-primary: var(--color-palette-accent-300);
    --color-action-primary-hover: var(--color-palette-accent-400);
    --color-action-primary-pressed: var(--color-palette-accent-500);
    --color-shadow-ambient: var(--color-black-a0);
    --gradient-surface-brand: radial-gradient(circle calc(0.85 * 100cqw) at 100% -5%, color-mix(in oklab, var(--color-palette-accent-alt-900) 45%, transparent) 0%, color-mix(in oklab, var(--color-palette-accent-alt-900) 43%, transparent) 16%, color-mix(in oklab, var(--color-palette-accent-alt-900) 24%, transparent) 36%, color-mix(in oklab, var(--color-palette-accent-alt-900) 11%, transparent) 56%, color-mix(in oklab, var(--color-palette-accent-alt-900) 4%, transparent) 76%, color-mix(in oklab, var(--color-palette-accent-alt-900) 0%, transparent) 100%), radial-gradient(circle calc(1.21 * 100cqw) at 5% 100%, color-mix(in oklab, var(--color-palette-primary-900) 45%, transparent) 0%, color-mix(in oklab, var(--color-palette-primary-900) 43%, transparent) 16%, color-mix(in oklab, var(--color-palette-primary-900) 24%, transparent) 36%, color-mix(in oklab, var(--color-palette-primary-900) 11%, transparent) 56%, color-mix(in oklab, var(--color-palette-primary-900) 4%, transparent) 76%, color-mix(in oklab, var(--color-palette-primary-900) 0%, transparent) 100%);
  }
}
",
}
`;
