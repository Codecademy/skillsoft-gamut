{
  "name": "gamut-styles",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/gamut-styles/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "build": {
      "outputs": ["{projectRoot}/dist"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/gamut-styles",
        "commands": [
          "rm -rf ./dist",
          "tsdown",
          "tsc --emitDeclarationOnly --project tsconfig.lib.json",
          "cpy './src/**/*.{d.ts,svg,png}' ./dist",
          "cpy './src/tokens/generated/*.{css,json}' ./dist/tokens/generated"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/vitest/gamut-styles"],
      "options": {
        "command": "vitest run --project=jsdom --project=node packages/gamut-styles/"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "rm -rf ./dist"
      }
    },
    "verify-package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          "publint .",
          "attw --pack . --ignore-rules false-cjs no-resolution"
        ],
        "parallel": false
      }
    },
    "publish-build": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": [],
        "parallel": false
      }
    }
  }
}
