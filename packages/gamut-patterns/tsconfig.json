{
  "extends": "../../tsconfig.base.json",
  "include": [
    "../../typings/*.d.ts",
    "./src/**/*.ts",
    "./src/**/*.tsx",
    "../gamut-styles/dist/typings/theme.d.ts"
  ],
  "compilerOptions": {
    "declaration": true,
    "strictFunctionTypes": false,
    "jsx": "react-jsx",
    "outDir": "./dist",
    "rootDir": "./src",
    "types": [],
    "paths": {
      "~storybook/blocks": ["../.storybook/components/"]
    }
  },
  "exclude": ["jest.config.ts", "**/*.stories.tsx"]
}
