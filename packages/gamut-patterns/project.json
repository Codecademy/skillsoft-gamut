{
  "name": "gamut-patterns",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/gamut-patterns/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "build": {
      "outputs": [
        "{projectRoot}/dist",
        "{projectRoot}/src/patterns",
        "{projectRoot}/dist",
        "{projectRoot}/src/patterns"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/gamut-patterns",
        "commands": [
          "rm -rf ./dist",
          "rm -rf ./src/patterns",
          "svgr --out-dir ./src/patterns --ext 'tsx' ./src/svg",
          "tsdown",
          "tsc --emitDeclarationOnly",
          "cpy './src/**/*.svg' ./dist"
        ],
        "parallel": false
      }
    },
    "test": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/vitest"],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/vitest.config.ts",
        "{workspaceRoot}/script/vitest/jsdom-setup.ts"
      ],
      "options": {
        "command": "vitest run --project=jsdom --coverage.enabled=${CI:-false} packages/gamut-patterns"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "rm -rf ./dist"
      }
    },
    "verify-package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "{projectRoot}",
        "commands": ["publint .", "attw --pack . --ignore-rules false-cjs"],
        "parallel": false
      }
    },
    "publish-build": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": [],
        "parallel": false
      }
    }
  }
}
