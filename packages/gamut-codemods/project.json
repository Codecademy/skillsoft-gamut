{
  "name": "gamut-codemods",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/gamut-codemods/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/gamut-codemods",
        "commands": [
          "rm -rf ./dist",
          "tsc -p tsconfig.lib.json",
          "chmod +x ./dist/bin.js"
        ],
        "parallel": false
      }
    },
    "test": {
      "dependsOn": ["^build"],
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/vitest"],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/vitest.config.ts",
        "{workspaceRoot}/script/vitest/node-setup.ts"
      ],
      "options": {
        "command": "vitest run --project=node --coverage.enabled=${CI:-false} packages/gamut-codemods"
      }
    },
    "verify-package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "{projectRoot}",
        "commands": ["publint ."],
        "parallel": false
      }
    },
    "publish-build": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": [],
        "parallel": false
      }
    }
  }
}
