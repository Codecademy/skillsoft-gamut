{
  "name": "macros",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/macros/lib",
  "projectType": "library",
  "tags": [],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/vitest"],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/vitest.config.ts",
        "{workspaceRoot}/script/vitest/jsdom-setup.ts"
      ],
      "options": {
        "command": "vitest run --project=jsdom --coverage.enabled=${CI:-false} packages/macros"
      }
    }
  }
}
