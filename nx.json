{
  "extends": "nx/presets/npm.json",
  "workspaceLayout": {
    "appsDir": "packages",
    "libsDir": "packages"
  },
  "namedInputs": {
    "babelConfig": ["{workspaceRoot}/babel.defaults.js"],
    "default": ["{projectRoot}/**/*"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/**/__tests__/**/*",
      "!{projectRoot}/**/__fixtures__/**/*",
      "!{projectRoot}/**/*.stories.@(js|jsx|ts|tsx|mdx)",
      "!{projectRoot}/.storybook/**/*",
      "!{projectRoot}/tsconfig.storybook.json"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production", "babelConfig"]
    },
    "lint": {
      "cache": true
    },
    "test": {
      "cache": true
    },
    "verify": {
      "cache": true
    },
    "@nx/jest:jest": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/jest.config.base.ts",
        "{workspaceRoot}/jest.preset.js",
        "babelConfig"
      ]
    }
  },
  "generators": {
    "@nrwl/js:library": {
      "buildable": true
    },
    "@nx/react:library": {
      "buildable": true,
      "publishable": true,
      "style": "@emotion/styled",
      "linter": "eslint"
    }
  },
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "nxCloudAccessToken": "ZmVjZWYxNzctYTdmZC00ODYzLTg4MzEtZTE1YTVmZDdkZmY1fHJlYWQ=",
  "parallel": 3,
  "defaultBase": "main",
  "pluginsConfig": {
    "@nx/js": {
      "analyzeSourceFiles": true,
      "projectsAffectedByDependencyUpdates": "auto"
    }
  },
  "analytics": false
}
